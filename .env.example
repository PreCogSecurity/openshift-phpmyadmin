# phpMyAdmin environment variables
#
# Copy this file to .env and adjust the values, or pass the variables directly
# to the container with -e / --env-file.
# See README.md "Environment variables summary" for details.

# Allow connection to an arbitrary server from the login page (set to 1 to enable)
PMA_ARBITRARY=0

# Address/host name of the MySQL server
PMA_HOST=db

# Comma separated list of address/host names of the MySQL servers
#PMA_HOSTS=db1,db2

# Verbose name of the MySQL server
#PMA_VERBOSE=My Database

# Comma separated list of verbose names of the MySQL servers
#PMA_VERBOSES=Database One,Database Two

# Port of the MySQL server
#PMA_PORT=3306

# Comma separated list of ports of the MySQL servers
#PMA_PORTS=3306,3307

# Username and password for config authentication method
#PMA_USER=root
#PMA_PASSWORD=secret

# Fully-qualified URI where phpMyAdmin is reachable behind a reverse proxy
#PMA_ABSOLUTE_URI=https://pma.example.net/